{
  "name": "melamcode-temple-manager",
  "version": "1.0.16",
  "description": "മേലാംകോട് ദേവിക്ഷേത്രം, ചെറ്റച്ചൽ - Windows Temple Management Application",
  "main": "main.js",
  "author": "Melamcode Devi Temple",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/run-tests.js",
    "pack:win": "electron-builder --win portable",
    "dist:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "in.chettachal.melamcode.templemanager",
    "productName": "Melamcode Temple Manager",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "ia32"
          ]
        }
      ],
      "artifactName": "Melamcode-Temple-Manager-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "മേലാംകോട് ക്ഷേത്ര മാനേജർ"
    }
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-malayalam": "^5.3.0",
    "indic-transliterator": "^1.3.1"
  }
}
